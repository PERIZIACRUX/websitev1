# =============================================================================
# CRUX × PERIZIA — .gitignore
# Next.js / TypeScript / Node.js project
# =============================================================================

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build outputs ───────────────────────────────────────────────────
/.next/
/out/
/build/
/dist/

# ─── Testing & coverage ──────────────────────────────────────────────────────
/coverage
*.lcov

# ─── Environment files — NEVER commit secrets ────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally NOT ignored — it should be committed

# ─── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── Operating system / editor artifacts ─────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Cryptographic / certificate files — NEVER commit ────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx

# ─── TypeScript build info ───────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Vercel / deployment ─────────────────────────────────────────────────────
.vercel

# ─── Misc ────────────────────────────────────────────────────────────────────
*.tgz
.turbo

/tests/*
jest.config.ts
jest.setup.ts